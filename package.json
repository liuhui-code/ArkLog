{
  "name": "arklog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "cargo run -p arklog --release",
    "build": "cargo build -p arklog --release",
    "test": "cargo test --workspace",
    "memory:check": "cargo run -p arklog --release -- --memory-probe 100000",
    "legacy:web:build": "tsc --noEmit && vite build",
    "legacy:web:test": "vitest run",
    "legacy:tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "5.4.21",
    "vitest": "^3.2.4"
  }
}
