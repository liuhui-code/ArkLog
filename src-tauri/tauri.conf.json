{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArkLog",
  "version": "0.1.0",
  "identifier": "com.arkline.arklog",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArkLog",
        "width": 1180,
        "height": 720,
        "minWidth": 860,
        "minHeight": 520,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
